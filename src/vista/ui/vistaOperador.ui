  <property name="styleSheet">
   <string notr="true">
    QMainWindow {
        background-color: #f9f7f2;
    }
    QWidget#centralwidget {
        background-color: #f9f7f2;
    }
    /* --- NAVBAR --- */
    QWidget#navbar {
        background-color: #ffffff;
        border-bottom: 1px solid #eeeeee;
    }
    QLabel#logoLabel {
        font-size: 22px;
        font-weight: bold;
        color: #5e8d8d;
        letter-spacing: 1px;
    }
    QPushButton#navBtn1, QPushButton#navBtn2, QPushButton#navBtn3 {
        background: transparent;
        border: none;
        font-size: 11px;
        font-weight: 500;
        color: #666666;
        padding: 5px 2px;
    }
    QPushButton#navBtn1 {
        color: #333333;
        border-bottom: 2px solid #5e8d8d;
    }
    QPushButton#navBtn1:hover, QPushButton#navBtn2:hover, QPushButton#navBtn3:hover {
        color: #5e8d8d;
    }
    QLabel#avatarLabel {
        background-color: #5e8d8d;
        color: white;
        font-weight: bold;
        font-size: 13px;
        border-radius: 17px;
        min-width: 34px;
        max-width: 34px;
        min-height: 34px;
        max-height: 34px;
    }
    QLabel#userNameLabel {
        font-size: 11px;
        color: #333333;
    }
    /* --- HERO --- */
    QLabel#heroTitle {
        font-size: 24px;
        font-weight: bold;
        color: #333333;
        letter-spacing: 2px;
    }
    QLabel#heroSubtitle {
        font-size: 13px;
        color: #666666;
    }
    /* --- CARDS --- */
    QFrame#card1, QFrame#card2, QFrame#card3 {
        background-color: #ffffff;
        border-radius: 15px;
        border: 1px solid #eeeeee;
    }
    QLabel#iconLabel1, QLabel#iconLabel2, QLabel#iconLabel3 {
        font-size: 32px;
    }
    QLabel#cardTitle1, QLabel#cardTitle2, QLabel#cardTitle3 {
        font-size: 11px;
        font-weight: bold;
        color: #333333;
        letter-spacing: 1px;
    }
    QLabel#cardDesc1, QLabel#cardDesc2, QLabel#cardDesc3 {
        font-size: 9px;
        color: #666666;
    }
    QPushButton#moreBtn1, QPushButton#moreBtn2, QPushButton#moreBtn3 {
        background-color: #f0f0f0;
        border: none;
        border-radius: 12px;
        padding: 6px 22px;
        font-size: 9px;
        color: #333333;
    }
    QPushButton#moreBtn1:hover, QPushButton#moreBtn2:hover, QPushButton#moreBtn3:hover {
        background-color: #e0e0e0;
    }
    /* --- CTA --- */
    QPushButton#ctaButton {
        background-color: #5e8d8d;
        color: white;
        border: none;
        border-radius: 25px;
        font-size: 12px;
        font-weight: bold;
        padding: 14px 40px;
        letter-spacing: 1px;
    }
    QPushButton#ctaButton:hover {
        background-color: #4a7474;
    }
    QLabel#ctaFooterText {
        font-size: 9px;
        color: #666666;
    }
    /* --- FOOTER --- */
    QLabel#footerLinks, QLabel#footerCopy {
        font-size: 9px;
        color: #666666;
    }
   </string>
