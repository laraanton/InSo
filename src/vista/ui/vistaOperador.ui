  <property name="styleSheet">
   <string notr="true">
QMainWindow { background-color: #1e2533; font-family: "Segoe UI", Arial, sans-serif; }
QWidget { font-family: "Segoe UI", Arial, sans-serif; background-color: #f9f7f2; }
QWidget#centralwidget { background-color: #1e2533; }
QFrame#sidebarFrame { background-color: #1e2533; border-right: none; }
QFrame#logoFrame { background-color: #161c28; border-bottom: 1px solid #2d3548; }
QPushButton#logoBtn { font-size: 20px; font-weight: bold; color: #7eb8b8; letter-spacing: 1px; background-color: transparent; border: none; padding: 0px; }
QPushButton#logoBtn:hover { color: #a0d4d4; }
QPushButton#btnNav1, QPushButton#btnNav2, QPushButton#btnNav3,
QPushButton#btnNav4, QPushButton#btnNav5, QPushButton#btnNav6 {
    background: transparent; border: none; border-left: 3px solid transparent;
    text-align: left; padding: 13px 20px; font-size: 16px; font-weight: 500; color: #a0aec0; }
QPushButton#btnNav1:hover, QPushButton#btnNav2:hover, QPushButton#btnNav3:hover,
QPushButton#btnNav4:hover, QPushButton#btnNav5:hover, QPushButton#btnNav6:hover {
    background-color: #2a3347; color: #7eb8b8; border-left: 3px solid #7eb8b8; }
QPushButton#btnNav1:checked, QPushButton#btnNav2:checked, QPushButton#btnNav3:checked,
QPushButton#btnNav4:checked, QPushButton#btnNav5:checked, QPushButton#btnNav6:checked {
    background-color: #2a3347; color: #7eb8b8; border-left: 3px solid #7eb8b8; font-weight: bold; }
QPushButton#btnLogout { background: transparent; border: none; border-top: 1px solid #444444;
    border-left: 3px solid transparent; text-align: left; padding: 12px 20px;
    font-size: 16px; color: #e05252; margin-top: 4px; }
QPushButton#btnLogout:hover { background-color: #3a2020; color: #ff7070; border-left: 3px solid #ff7070; }
QLabel#sidebarFooter { font-size: 12px; color: #4a5568; padding: 6px 10px; background-color: transparent; }
QFrame#topbarFrame { background-color: #f9f7f2; border-bottom: 1px solid #e8e5de; }
QLabel#pageTitle { font-size: 18px; font-weight: bold; color: #333333; letter-spacing: 1px; }
QLabel#pageBreadcrumb { font-size: 14px; color: #999999; }
QLabel#avatarLabel { background-color: #5e8d8d; color: white; font-weight: bold; font-size: 18px;
    border-radius: 17px; min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px; }
QLabel#userNameLabel { font-size: 18px; color: #333333; }
QLabel#heroTitle { font-size: 26px; font-weight: bold; color: #333333; letter-spacing: 2px; }
QLabel#heroSubtitle { font-size: 16px; color: #666666; }
QFrame#card1, QFrame#card2, QFrame#card3,
QFrame#card4, QFrame#card5, QFrame#card6 {
    background-color: #ffffff; border-radius: 15px; border: 1px solid #eeeeee; }
QLabel#iconLabel1, QLabel#iconLabel2, QLabel#iconLabel3,
QLabel#iconLabel4, QLabel#iconLabel5, QLabel#iconLabel6 { font-size: 36px; color: #5e8d8d; }
QLabel#cardTitle1, QLabel#cardTitle2, QLabel#cardTitle3,
QLabel#cardTitle4, QLabel#cardTitle5, QLabel#cardTitle6 {
    font-size: 18px; font-weight: bold; color: #333333; letter-spacing: 1px; }
QLabel#cardDesc1, QLabel#cardDesc2, QLabel#cardDesc3,
QLabel#cardDesc4, QLabel#cardDesc5, QLabel#cardDesc6 { font-size: 16px; color: #666666; }
QPushButton#moreBtn1, QPushButton#moreBtn2, QPushButton#moreBtn3,
QPushButton#moreBtn4, QPushButton#moreBtn5, QPushButton#moreBtn6 {
    background-color: #5e8d8d; color: white; border: none; border-radius: 20px;
    padding: 8px 24px; font-size: 16px; font-weight: bold; letter-spacing: 0.5px; }
QPushButton#moreBtn1:hover, QPushButton#moreBtn2:hover, QPushButton#moreBtn3:hover,
QPushButton#moreBtn4:hover, QPushButton#moreBtn5:hover, QPushButton#moreBtn6:hover { background-color: #4a7474; }
QLabel#footerLinks, QLabel#footerCopy { font-size: 13px; color: #bbbbbb; }
QScrollArea#hubScrollArea { border: none; background-color: #f9f7f2; }
QScrollArea#hubScrollArea > QWidget > QWidget { background-color: #f9f7f2; }
QScrollBar:vertical { background: #f9f7f2; width: 6px; margin: 0px; }
QScrollBar::handle:vertical { background: #d0d0d0; border-radius: 3px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
