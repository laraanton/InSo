    font-weight: bold;
    color: #333333;
}
QLabel#kpiLabel1, QLabel#kpiLabel2,
QLabel#kpiLabel3, QLabel#kpiLabel4 {
    font-size: 9px;
    color: #888888;
    letter-spacing: 1px;
}

/* ── Sección título ─────────────────────────────────── */
QLabel#sectionLabel {
    font-size: 10px;
    font-weight: bold;
    color: #5e8d8d;
    letter-spacing: 2px;
}

/* ── Chart cards ────────────────────────────────────── */
QFrame#chartCard1, QFrame#chartCard2,
QFrame#chartCard3, QFrame#chartCard4,
QFrame#chartCard5, QFrame#chartCard6 {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #eeeeee;
}
QLabel#chartTitle1, QLabel#chartTitle2,
QLabel#chartTitle3, QLabel#chartTitle4,
QLabel#chartTitle5, QLabel#chartTitle6 {
    font-size: 10px;
    font-weight: bold;
    color: #333333;
    letter-spacing: 0.5px;
}
QLabel#chartSub1, QLabel#chartSub2,
QLabel#chartSub3, QLabel#chartSub4,
QLabel#chartSub5, QLabel#chartSub6 {
    font-size: 8px;
    color: #aaaaaa;
}

/* ── Placeholder chart areas ────────────────────────── */
QFrame#chartArea1, QFrame#chartArea2,
QFrame#chartArea3, QFrame#chartArea4,
QFrame#chartArea5, QFrame#chartArea6 {
    background-color: #f4f2ed;
    border-radius: 8px;
    border: 1px dashed #dddddd;
}
QLabel#chartPlaceholder1, QLabel#chartPlaceholder2,
QLabel#chartPlaceholder3, QLabel#chartPlaceholder4,
QLabel#chartPlaceholder5, QLabel#chartPlaceholder6 {
    font-size: 28px;
    color: #cccccc;
}

/* ── Combo selector ─────────────────────────────────── */
QComboBox#cbPeriodo {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 10px;
    color: #333333;
    min-width: 120px;
}
QComboBox#cbPeriodo::drop-down {
    border: none;
    width: 20px;
}
QComboBox#cbPeriodo:hover {
    border-color: #5e8d8d;
}

/* ── Botón exportar ─────────────────────────────────── */
QPushButton#btnExportar {
    background-color: #5e8d8d;
    color: white;
    border: none;
    border-radius: 20px;
    padding: 8px 22px;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.5px;
}
QPushButton#btnExportar:hover {
    background-color: #4a7474;
}

/* ── Scroll ─────────────────────────────────────────── */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}
QScrollBar:vertical {
    background: #f9f7f2;
    width: 6px;
}
QScrollBar::handle:vertical {
    background: #d0d0d0;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }
