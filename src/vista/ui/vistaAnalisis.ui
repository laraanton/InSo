/* ── Contenedor principal ───────────────────────────── */
QWidget#pageAnalisis {
    background-color: #f9f7f2;
}

/* ── KPI cards ──────────────────────────────────────── */
QFrame#kpiCard1, QFrame#kpiCard2,
