<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PageDashboardUI</class>
 <widget class="QWidget" name="PageDashboardUI">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1060</width><height>740</height></rect>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #f9f7f2;
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica Neue&quot;, sans-serif;
    font-size: 13px;
    color: #333333;
}
QFrame#cardOperadores, QFrame#cardClientes,
QFrame#cardBloqueados, QFrame#cardTotal {
    background-color: #FFFFFF;
    border: 1px solid #e8e4dc;
    border-radius: 8px;
    padding: 16px;
}
QFrame#cardOperadores { border-top: 3px solid #5e8d8d; }
QFrame#cardClientes   { border-top: 3px solid #7a8c4e; }
QFrame#cardBloqueados { border-top: 3px solid #c0392b; }
QFrame#cardTotal      { border-top: 3px solid #b08a4e; }
QLabel#lblCardOpTitulo, QLabel#lblCardClTitulo,
QLabel#lblCardBlTitulo, QLabel#lblCardTotTitulo {
    color: #666666; font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
}
QLabel#lblTotalOperadores, QLabel#lblTotalClientes,
QLabel#lblTotalBloqueados, QLabel#lblTotalUsuarios {
    color: #333333; font-size: 34px; font-weight: 800;
}
QLabel#lblCardOpSub, QLabel#lblCardClSub,
QLabel#lblCardBlSub, QLabel#lblCardTotSub { color: #666666; font-size: 11px; }
QLabel#lblDashActTitle, QLabel#lblHistorialTitle,
QLabel#lblBackupTitle, QLabel#lblSysTitle {
    color: #333333; font-size: 14px; font-weight: 700;
}
QTableWidget {
    background-color: #FFFFFF; border: 1px solid #e8e4dc;
    border-radius: 8px; gridline-color: transparent; outline: none;
    font-size: 13px; color: #333333;
    selection-background-color: #eef4f4; selection-color: #5e8d8d;
}
QTableWidget::item { padding: 10px 14px; border-bottom: 1px solid #f3f0ea; }
QTableWidget::item:selected { background-color: #eef4f4; color: #5e8d8d; }
QHeaderView::section {
    background-color: #f9f7f2; color: #666666; font-size: 10px;
    font-weight: 700; letter-spacing: 1.1px; padding: 9px 14px;
    border: none; border-bottom: 2px solid #e8e4dc;
}
QScrollBar:vertical { background: #f9f7f2; width: 6px; border-radius: 3px; }
QScrollBar::handle:vertical { background: #cac5bc; border-radius: 3px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar:horizontal { background: #f9f7f2; height: 6px; border-radius: 3px; }
QScrollBar::handle:horizontal { background: #cac5bc; border-radius: 3px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QLineEdit {
    background-color: #FFFFFF; border: 1px solid #e8e4dc;
    border-radius: 6px; padding: 8px 12px; font-size: 13px; color: #333333;
}
QLineEdit:hover { border-color: #c8c0b4; }
QLineEdit:focus { border: 1.5px solid #5e8d8d; background-color: #fafaf8; }
QComboBox {
    background-color: #FFFFFF; border: 1px solid #e8e4dc;
    border-radius: 6px; padding: 7px 12px; font-size: 13px;
    color: #333333; min-width: 150px;
}
QComboBox:hover { border-color: #c8c0b4; }
QComboBox:focus { border: 1.5px solid #5e8d8d; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF; border: 1px solid #e8e4dc; outline: none;
    selection-background-color: #eef4f4; selection-color: #5e8d8d; font-size: 13px;
}
QFrame#backupCard {
    background-color: #FFFFFF; border: 1px solid #e8e4dc;
    border-top: 3px solid #5e8d8d; border-radius: 8px; padding: 20px;
}
QFrame#infoSistemaCard {
    background-color: #FFFFFF; border: 1px solid #e8e4dc;
    border-top: 3px solid #7a8c4e; border-radius: 8px; padding: 20px;
}
QLabel#lblBackupDesc, QLabel#lblPython, QLabel#lblHost, QLabel#bkLast1 {
    color: #666666; font-size: 12px;
}
QPushButton#btnNuevoOperador {
    background-color: #5e8d8d; color: #FFFFFF; border: none;
    border-radius: 6px; padding: 8px 16px; font-size: 13px; font-weight: 600;
}
QPushButton#btnNuevoOperador:hover { background-color: #4e7a7a; }
QPushButton#btnExportarOp {
    background-color: #7a8c4e; color: #FFFFFF; border: none;
    border-radius: 6px; padding: 8px 16px; font-size: 12px; font-weight: 600;
}
QPushButton#btnExportarOp:hover { background-color: #697a3e; }
QPushButton#btnVerTodosDash {
    background-color: #FFFFFF; color: #5e8d8d; border: 1px solid #5e8d8d;
    border-radius: 6px; padding: 6px 14px; font-size: 12px; font-weight: 600;
}
QPushButton#btnVerTodosDash:hover { background-color: #eef4f4; }
QPushButton#btnBackupAhora {
    background-color: #5e8d8d; color: #FFFFFF; border: none;
    border-radius: 6px; padding: 10px 22px; font-size: 13px; font-weight: 600; margin-top: 8px;
}
QPushButton#btnBackupAhora:hover { background-color: #4e7a7a; }
QPushButton#btnEdit {
    background-color: #eef4f4; color: #5e8d8d; border: 1px solid #c5dcdc;
    border-radius: 4px; padding: 4px 10px; font-size: 11px; font-weight: 600;
}
QPushButton#btnEdit:hover { background-color: #d4e8e8; }
QPushButton#btnDanger {
    background-color: #fdecea; color: #c0392b; border: 1px solid #f5c6c3;
    border-radius: 4px; padding: 4px 10px; font-size: 11px; font-weight: 600;
}
QPushButton#btnDanger:hover { background-color: #f9d4d1; }
QPushButton#btnSuccess {
    background-color: #eafaf1; color: #27ae60; border: 1px solid #b7e4c7;
    border-radius: 4px; padding: 4px 10px; font-size: 11px; font-weight: 600;
}
QPushButton#btnSuccess:hover { background-color: #d4f0e0; }
QPushButton#btnSecondary {
    background-color: #FFFFFF; color: #333333; border: 1px solid #e8e4dc;
    border-radius: 4px; padding: 4px 10px; font-size: 11px;
}
QPushButton#btnSecondary:hover { border-color: #5e8d8d; color: #5e8d8d; }</string>
  </property>
  <layout class="QVBoxLayout" name="dashLayout">
   <property name="leftMargin"><number>28</number></property>
   <property name="topMargin"><number>24</number></property>
   <property name="rightMargin"><number>28</number></property>
   <property name="bottomMargin"><number>24</number></property>
   <property name="spacing"><number>16</number></property>

   <!-- Tarjetas métricas -->
   <item>
    <layout class="QHBoxLayout" name="cardsLayout">
     <property name="spacing"><number>16</number></property>
     <item>
      <widget class="QFrame" name="cardOperadores">
       <property name="minimumHeight"><number>110</number></property>
       <layout class="QVBoxLayout" name="cardOpLayout">
        <property name="spacing"><number>4</number></property>
        <item><widget class="QLabel" name="lblCardOpTitulo"><property name="text"><string>OPERADORES ACTIVOS</string></property></widget></item>
        <item><widget class="QLabel" name="lblTotalOperadores"><property name="text"><string>0</string></property></widget></item>
        <item><widget class="QLabel" name="lblCardOpSub"><property name="text"><string>en el sistema</string></property></widget></item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QFrame" name="cardClientes">
       <property name="minimumHeight"><number>110</number></property>
       <layout class="QVBoxLayout" name="cardClLayout">
        <property name="spacing"><number>4</number></property>
        <item><widget class="QLabel" name="lblCardClTitulo"><property name="text"><string>CLIENTES</string></property></widget></item>
        <item><widget class="QLabel" name="lblTotalClientes"><property name="text"><string>0</string></property></widget></item>
        <item><widget class="QLabel" name="lblCardClSub"><property name="text"><string>registrados</string></property></widget></item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QFrame" name="cardBloqueados">
       <property name="minimumHeight"><number>110</number></property>
       <layout class="QVBoxLayout" name="cardBlLayout">
        <property name="spacing"><number>4</number></property>
        <item><widget class="QLabel" name="lblCardBlTitulo"><property name="text"><string>CUENTAS BLOQUEADAS</string></property></widget></item>
        <item><widget class="QLabel" name="lblTotalBloqueados"><property name="text"><string>0</string></property></widget></item>
        <item><widget class="QLabel" name="lblCardBlSub"><property name="text"><string>requieren atención</string></property></widget></item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QFrame" name="cardTotal">
       <property name="minimumHeight"><number>110</number></property>
       <layout class="QVBoxLayout" name="cardTotLayout">
        <property name="spacing"><number>4</number></property>
        <item><widget class="QLabel" name="lblCardTotTitulo"><property name="text"><string>TOTAL USUARIOS</string></property></widget></item>
        <item><widget class="QLabel" name="lblTotalUsuarios"><property name="text"><string>0</string></property></widget></item>
        <item><widget class="QLabel" name="lblCardTotSub"><property name="text"><string>en la plataforma</string></property></widget></item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Cabecera actividad reciente -->
   <item>
    <layout class="QHBoxLayout" name="dashActHeader">
     <item><widget class="QLabel" name="lblDashActTitle"><property name="text"><string>Actividad Reciente</string></property></widget></item>
     <item>
      <spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer>
     </item>
     <item>
      <widget class="QPushButton" name="btnVerTodosDash">
       <property name="text"><string>Ver todo</string></property>
       <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Tabla actividad reciente -->
   <item>
