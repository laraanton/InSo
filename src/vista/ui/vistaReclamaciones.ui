  <property name="styleSheet">
   <string notr="true">
QWidget#pageReclamaciones { background-color: #f9f7f2; }

QLabel#lblTitulo {
    font-size: 22px; font-weight: bold;
    color: #333333; letter-spacing: 2px;
}
QLabel#lblSubtitulo { font-size: 12px; color: #888888; }

QFrame#filterBar {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #eeeeee;
}
QLineEdit#inputBuscar {
    background-color: #f4f2ed;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px; color: #333333;
}
QLineEdit#inputBuscar:focus { border-color: #5e8d8d; }
QComboBox#comboCategoria, QComboBox#comboEstado {
    background-color: #f4f2ed;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px; color: #333333;
    min-width: 140px;
}
QComboBox#comboCategoria:hover, QComboBox#comboEstado:hover { border-color: #5e8d8d; }
QPushButton#btnBuscar {
    background-color: #5e8d8d; color: white;
    border: none; border-radius: 8px;
    padding: 7px 20px; font-size: 12px; font-weight: bold;
}
QPushButton#btnBuscar:hover { background-color: #4a7474; }
QPushButton#btnLimpiar {
    background-color: transparent; color: #888888;
    border: 1px solid #dddddd; border-radius: 8px;
    padding: 7px 16px; font-size: 12px;
}
QPushButton#btnLimpiar:hover { border-color: #5e8d8d; color: #5e8d8d; }

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: 12px;
    gridline-color: #f0ede8;
    font-size: 12px; color: #333333;
    selection-background-color: #fef3e2;
    selection-color: #333333;
}
QTableWidget::item { padding: 10px 12px; border-bottom: 1px solid #f0ede8; }
QTableWidget::item:selected { background-color: #fef3e2; }
QHeaderView::section {
    background-color: #f4f2ed;
    color: #5e8d8d;
    font-weight: bold; font-size: 11px;
    letter-spacing: 1px;
    padding: 10px 12px;
    border: none; border-bottom: 2px solid #e0ddd8;
}

QFrame#detalleFrame {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #eeeeee;
}
QLabel#lblDetalleTitle { font-size: 14px; font-weight: bold; color: #333333; }
QLabel#lblDetalleSub   { font-size: 11px; color: #888888; }

QLabel#lblCampoTit {
    font-size: 10px; color: #aaaaaa;
    font-weight: bold; letter-spacing: 1px;
}
QLabel#lblCampoVal {
    font-size: 12px; color: #333333;
}
QLabel#lblDescTit {
    font-size: 10px; color: #aaaaaa;
    font-weight: bold; letter-spacing: 1px;
}
QLabel#lblDesc {
    font-size: 12px; color: #444444;
    background-color: #f9f7f2;
    border-radius: 8px; padding: 10px;
}

QComboBox#comboEstadoDetalle {
    background-color: #f4f2ed;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 6px 10px; font-size: 12px;
}
QPushButton#btnGuardarEstado {
    background-color: #5e8d8d; color: white;
    border: none; border-radius: 8px;
    padding: 7px 18px; font-size: 12px; font-weight: bold;
}
QPushButton#btnGuardarEstado:hover { background-color: #4a7474; }

QLabel#lblEstado { font-size: 11px; font-weight: bold; }

QScrollBar:vertical { background: #f9f7f2; width: 6px; }
QScrollBar::handle:vertical { background: #d0d0d0; border-radius: 3px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
