  <property name="styleSheet">
   <string>
QMainWindow, QWidget#centralwidget { background-color: #F5F3EF; font-family: "Segoe UI", sans-serif; }
QWidget#panel_izquierdo { background-color: #FFFFFF; border-right: 1px solid #E0DDD7; }
QWidget#panel_derecho { background-color: #FAF9F6; }
QWidget#topbar { background-color: #FFFFFF; border-bottom: 1px solid #E0DDD7; }
QPushButton#btn_volver {
    background-color: #FFFFFF; border: 1px solid #D4D0C8;
    border-radius: 8px; padding: 6px 16px; font-size: 13px; color: #2C2A27;
}
QPushButton#btn_volver:hover { background-color: #F0EDE7; }
QLabel#lbl_breadcrumb_sep { color: #C0BDB7; font-size: 13px; }
QLabel#lbl_breadcrumb_actual { color: #2C2A27; font-size: 13px; font-weight: 600; }
QWidget#icono_destino { background-color: #EBE8E1; border-radius: 12px; }
QLabel#lbl_nombre_paquete { font-size: 26px; font-weight: 700; color: #1A1917; }
QLabel#lbl_meta { font-size: 13px; color: #6B6860; }
QWidget#chip_frame, QWidget#chip_frame_acc, QWidget#chip_frame_perfil {
    background-color: #F0EDE7; border-radius: 16px; border: 1px solid #E0DDD7;
}
QLabel#chip_label { font-size: 12px; color: #4A4845; padding: 4px 10px; }
QWidget#stats_box_noches, QWidget#stats_box_precio, QWidget#stats_box_total,
QWidget#stats_box_estado, QWidget#stats_box_pago {
    background-color: #F5F3EF; border-radius: 10px; border: 1px solid #E0DDD7;
}
QLabel#stat_valor { font-size: 18px; font-weight: 700; color: #1A1917; }
QLabel#stat_label { font-size: 11px; color: #9A9690; }
QLabel#lbl_desc_titulo { font-size: 10px; font-weight: 700; color: #9A9690; letter-spacing: 2px; }
QLabel#lbl_descripcion { font-size: 13px; color: #4A4845; }
QWidget#info_box {
    background-color: #FFFFFF; border-radius: 10px; border: 1px solid #E0DDD7;
}
QLabel#info_titulo { font-size: 18px; font-weight: 700; color: #1A1917; }
QLabel#info_campo { font-size: 12px; color: #6B6860; font-weight: 500; }
QLabel#info_valor { font-size: 15px; color: #1A1917; font-weight: 600; }
QLabel#lbl_estado_badge {
    font-size: 12px; font-weight: 600; padding: 4px 14px;
    border-radius: 12px; background-color: #E8F5E9; color: #2E7D32;
}
QFrame#sep_vertical { background-color: #E0DDD7; }
   </string>
