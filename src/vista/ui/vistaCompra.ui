    background-color: #f9f7f2;
    border: 1px solid #dddddd;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    color: #333333;
}
QLineEdit:focus {
    border: 1px solid #5e8d8d;
    background-color: #ffffff;
}
QComboBox {
    background-color: #f9f7f2;
    border: 1px solid #dddddd;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11px;
    color: #333333;
}
QComboBox:focus {
    border: 1px solid #5e8d8d;
}
QTableWidget {
    background-color: #ffffff;
    border: none;
    gridline-color: #f0ede6;
    font-size: 11px;
    color: #333333;
}
QTableWidget::item {
    padding: 8px 10px;
}
QTableWidget::item:selected {
    background-color: #e8f2f2;
    color: #333333;
}
QHeaderView::section {
    background-color: #f9f7f2;
    border: none;
    border-bottom: 2px solid #eeeeee;
    padding: 8px 10px;
    font-size: 10px;
    font-weight: bold;
    color: #999999;
    letter-spacing: 0.5px;
}
QPushButton#btnNuevaReserva {
    background-color: #5e8d8d;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 11px;
    font-weight: bold;
    color: white;
}
QPushButton#btnNuevaReserva:hover {
    background-color: #4a7474;
}
QPushButton#btnExportar {
    background-color: transparent;
    border: 1px solid #5e8d8d;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 11px;
    font-weight: bold;
    color: #5e8d8d;
}
QPushButton#btnExportar:hover {
    background-color: #5e8d8d;
    color: white;
}
QLabel#lblEstado {
    font-size: 11px;
    font-weight: bold;
}
QScrollBar:vertical {
    background: #f9f7f2;
    width: 6px;
}
QScrollBar::handle:vertical {
    background: #d0d0d0;
    border-radius: 3px;
    min-height: 20px;
}
QLabel#lblSeccionTitulo { font-size: 20px; }  /* se queda igual */
QLabel#lblSeccionSub { font-size: 16px; }      /* era 11px */
QLabel { font-size: 16px; }                    /* era 11px */
QLineEdit { font-size: 16px; }                 /* era 11px */
QComboBox { font-size: 16px; }                 /* era 11px */
QTableWidget { font-size: 16px; }              /* era 11px */
QHeaderView::section { font-size: 15px; }      /* era 10px */
QPushButton#btnNuevaReserva { font-size: 16px; } /* era 11px */
QPushButton#btnExportar { font-size: 16px; }   /* era 11px */
QLabel#lblEstado { font-size: 16px; }          /* era 11px */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
