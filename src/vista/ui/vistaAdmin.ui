QMainWindow {
    background-color: #f9f7f2;
}
QWidget {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #333333;
}
QWidget#centralwidget {
    background-color: #f9f7f2;
}
QFrame#sidebarFrame {
    background-color: #2c3e50;
    border: none;
}
QFrame#logoFrame {
    background-color: #243342;
    border: none;
}
QLabel#logoLabel {
    color: #ecf0f1;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 2px;
}
QPushButton#btnNavDashboard,
QPushButton#btnNavOperadores,
QPushButton#btnNavUsuarios,
QPushButton#btnNavActividad,
QPushButton#btnNavSistema {
    background-color: transparent;
    color: #b0bec5;
    border: none;
    border-radius: 0px;
    text-align: left;
    padding: 13px 24px;
    font-size: 13px;
    font-weight: 500;
    min-height: 46px;
}
QPushButton#btnNavDashboard:hover,
QPushButton#btnNavOperadores:hover,
QPushButton#btnNavUsuarios:hover,
QPushButton#btnNavActividad:hover,
QPushButton#btnNavSistema:hover {
    background-color: #3d5166;
    color: #ecf0f1;
}
QPushButton#btnNavDashboard:checked,
QPushButton#btnNavOperadores:checked,
QPushButton#btnNavUsuarios:checked,
QPushButton#btnNavActividad:checked,
QPushButton#btnNavSistema:checked {
    background-color: #5e8d8d;
    color: #ffffff;
    border-left: 4px solid #a8d8d8;
    padding-left: 20px;
    font-weight: 700;
}
QPushButton#btnLogout {
    background-color: transparent;
    color: #e74c3c;
    border: none;
    text-align: left;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 500;
    min-height: 44px;
}
QPushButton#btnLogout:hover {
    background-color: #3d2323;
    color: #ff6b6b;
}
QLabel#sidebarFooter {
    color: #607d8b;
    font-size: 10px;
    font-style: italic;
    padding: 8px 12px;
}
QFrame#topbarFrame {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e8e4dc;
}
QLabel#pageTitle {
    color: #1a2533;
    font-size: 18px;
    font-weight: 700;
}
QLabel#pageBreadcrumb {
    color: #90a4ae;
    font-size: 11px;
}
QLabel#avatarLabel {
    min-width:  36px;
    max-width:  36px;
    min-height: 36px;
    max-height: 36px;
    border-radius: 18px;
    background-color: #5e8d8d;
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}
QLabel#adminNameLabel {
    color: #2c3e50;
    font-size: 13px;
    font-weight: 600;
}
QFrame#contentFrame {
    background-color: #f9f7f2;
    border: none;
}
