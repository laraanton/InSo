<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>VentanaAdminUI</class>
 <widget class="QMainWindow" name="VentanaAdminUI">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1280</width><height>800</height></rect>
  </property>
  <property name="windowTitle">
   <string>SoftTrip — Administración</string>
  </property>

  <!-- ═══════════════════════════════════════════════════════════════
       QSS GLOBAL de la ventana principal.
       Incluye:
         · Sidebar (fondo, botones de navegación, estado activo, logout)
         · Topbar (fondo, separador inferior)
         · avatarLabel → círculo 36×36 con border-radius: 18px
         · adminNameLabel → tipografía del nombre
         · pageTitle / pageBreadcrumb
       REGLA DEL PROYECTO: ningún .py usa setStyleSheet.
  ════════════════════════════════════════════════════════════════════ -->
  <property name="styleSheet">
   <string notr="true">
/* ── Base ──
   CRÍTICO: background-color NO va en QWidget genérico.
   Si se pone ahí, todos los QWidget hijos del sidebar (logoFrame, botones)
   heredan el fondo crema #f9f7f2 y tapan el fondo oscuro del sidebar.
   El fondo crema va solo en contentFrame y sus hijos. */
QMainWindow {
    background-color: #f9f7f2;
}
QWidget {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #333333;
}
QWidget#centralwidget {
    background-color: #f9f7f2;
}

/* ── Sidebar ── */
QFrame#sidebarFrame {
    background-color: #2c3e50;
    border: none;
}

/* Logo */
QFrame#logoFrame {
    background-color: #243342;
    border: none;
}
QLabel#logoLabel {
    color: #ecf0f1;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 2px;
}

/* Botones de navegación — estado normal */
QPushButton#btnNavDashboard,
QPushButton#btnNavOperadores,
QPushButton#btnNavUsuarios,
QPushButton#btnNavActividad,
QPushButton#btnNavSistema {
    background-color: transparent;
    color: #b0bec5;
    border: none;
    border-radius: 0px;
    text-align: left;
    padding: 13px 24px;
    font-size: 13px;
    font-weight: 500;
    min-height: 46px;
}
QPushButton#btnNavDashboard:hover,
QPushButton#btnNavOperadores:hover,
QPushButton#btnNavUsuarios:hover,
QPushButton#btnNavActividad:hover,
QPushButton#btnNavSistema:hover {
    background-color: #3d5166;
    color: #ecf0f1;
}

/* Estado activo: se activa con btn.setProperty("active", True) en VentanaAdmin */
QPushButton#btnNavDashboard[active="true"],
QPushButton#btnNavOperadores[active="true"],
QPushButton#btnNavUsuarios[active="true"],
QPushButton#btnNavActividad[active="true"],
QPushButton#btnNavSistema[active="true"] {
    background-color: #5e8d8d;
    color: #ffffff;
    border-left: 4px solid #a8d8d8;
    padding-left: 20px;
    font-weight: 700;
}

/* Botón logout */
QPushButton#btnLogout {
    background-color: transparent;
    color: #e74c3c;
    border: none;
    text-align: left;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 500;
    min-height: 44px;
}
QPushButton#btnLogout:hover {
    background-color: #3d2323;
    color: #ff6b6b;
}

/* Footer del sidebar */
QLabel#sidebarFooter {
    color: #607d8b;
    font-size: 10px;
    font-style: italic;
    padding: 8px 12px;
}

/* ── Topbar ── */
QFrame#topbarFrame {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e8e4dc;
}

QLabel#pageTitle {
    color: #1a2533;
    font-size: 18px;
    font-weight: 700;
}
QLabel#pageBreadcrumb {
    color: #90a4ae;
    font-size: 11px;
}

/* ── Avatar circular ──
   CRÍTICO: min/max iguales a 36px para que border-radius: 18px funcione.
   background-color es obligatorio — sin él Qt no recorta la forma.        */
QLabel#avatarLabel {
    min-width:  36px;
    max-width:  36px;
    min-height: 36px;
    max-height: 36px;
    border-radius: 18px;
    background-color: #5e8d8d;
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}

/* Nombre del administrador junto al avatar */
QLabel#adminNameLabel {
    color: #2c3e50;
    font-size: 13px;
    font-weight: 600;
}

/* ── Área de contenido ── */
QFrame#contentFrame {
    background-color: #f9f7f2;
    border: none;
}
   </string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="rootLayout">
    <property name="spacing"><number>0</number></property>
    <property name="leftMargin"><number>0</number></property>
    <property name="topMargin"><number>0</number></property>
    <property name="rightMargin"><number>0</number></property>
    <property name="bottomMargin"><number>0</number></property>

    <!-- ══ SIDEBAR ══════════════════════════════════════════════════════ -->
    <item>
     <widget class="QFrame" name="sidebarFrame">
      <!-- FIX #2: min y max iguales a 220 → ancho fijo visible, no colapsa -->
      <property name="minimumWidth"><number>220</number></property>
      <property name="maximumWidth"><number>220</number></property>
      <layout class="QVBoxLayout" name="sidebarLayout">
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>

       <!-- Logo -->
       <item>
        <widget class="QFrame" name="logoFrame">
         <property name="minimumHeight"><number>72</number></property>
         <property name="maximumHeight"><number>72</number></property>
         <layout class="QHBoxLayout" name="logoLayout">
          <item>
           <widget class="QLabel" name="logoLabel">
            <property name="text"><string>✈  SOFTRIP</string></property>
            <property name="alignment"><set>Qt::AlignCenter</set></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <!-- Botones de navegación -->
       <item>
        <widget class="QPushButton" name="btnNavDashboard">
         <property name="text"><string>   Dashboard</string></property>
         <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnNavOperadores">
         <property name="text"><string>   Operadores</string></property>
         <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnNavUsuarios">
         <property name="text"><string>   Todos los Usuarios</string></property>
         <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnNavActividad">
         <property name="text"><string>   Registro de Actividad</string></property>
         <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnNavSistema">
         <property name="text"><string>   Sistema y Backups</string></property>
         <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
        </widget>
       </item>

       <!-- Espaciador empuja logout al fondo -->
       <item>
        <spacer name="sidebarSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
        </spacer>
       </item>

       <item>
        <widget class="QPushButton" name="btnLogout">
         <property name="text"><string>   Cerrar sesión</string></property>
         <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="sidebarFooter">
         <property name="text"><string>Haz las maletas. Nosotros el resto.</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
        </widget>
       </item>

      </layout>
     </widget>
    </item>

    <!-- ══ CONTENIDO PRINCIPAL ══════════════════════════════════════════ -->
    <item>
     <widget class="QFrame" name="contentFrame">
      <layout class="QVBoxLayout" name="contentLayout">
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>

       <!-- ── Topbar ─────────────────────────────────────────────────── -->
       <item>
        <widget class="QFrame" name="topbarFrame">
         <property name="minimumHeight"><number>64</number></property>
         <property name="maximumHeight"><number>64</number></property>
         <layout class="QHBoxLayout" name="topbarLayout">
          <property name="leftMargin"><number>28</number></property>
          <property name="rightMargin"><number>24</number></property>
          <property name="spacing"><number>8</number></property>

          <!-- Título + breadcrumb -->
          <item>
           <layout class="QVBoxLayout" name="titleStack">
            <property name="spacing"><number>2</number></property>
            <item>
             <widget class="QLabel" name="pageTitle">
              <property name="text"><string>Dashboard</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="pageBreadcrumb">
              <property name="text"><string>Softrip › Administración</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <!-- Spacer empuja avatar a la derecha -->
          <item>
           <spacer name="topSpacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>

          <!-- FIX #4: avatarLabel con minimumSize = maximumSize = 36×36
               El QSS de arriba aplica border-radius:18px + background-color
               para que el recorte circular sea visible.                      -->
          <item>
           <widget class="QLabel" name="avatarLabel">
            <property name="text"><string>A</string></property>
            <property name="alignment"><set>Qt::AlignCenter</set></property>
            <property name="minimumSize">
             <size><width>36</width><height>36</height></size>
            </property>
            <property name="maximumSize">
             <size><width>36</width><height>36</height></size>
            </property>
           </widget>
          </item>

          <!-- Nombre del administrador -->
          <item>
           <widget class="QLabel" name="adminNameLabel">
            <property name="text"><string>Administrador</string></property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <!-- ── StackedWidget (páginas) ────────────────────────────────── -->
       <item>
        <widget class="QStackedWidget" name="stackedWidget"/>
       </item>

      </layout>
     </widget>
    </item>

   </layout>
  </widget>
 </widget>
</ui>
