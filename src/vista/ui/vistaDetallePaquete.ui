  <property name="windowTitle"><string>Detalle del paquete</string></property>
  <property name="styleSheet">
   <string>
QMainWindow, QWidget#centralwidget {
    background-color: #F5F3EF;
    font-family: "Segoe UI", sans-serif;
}
QWidget#panel_izquierdo {
    background-color: #FFFFFF;
    border-right: 1px solid #E0DDD7;
}
QWidget#panel_derecho {
    background-color: #FAF9F6;
}
QWidget#topbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0DDD7;
}
QPushButton#btn_volver {
    background-color: #FFFFFF;
    border: 1px solid #D4D0C8;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    color: #2C2A27;
}
QPushButton#btn_volver:hover { background-color: #F0EDE7; }
QLabel#lbl_breadcrumb {
    color: #9A9690;
    font-size: 13px;
}
QLabel#lbl_breadcrumb_sep {
    color: #C0BDB7;
    font-size: 13px;
}
QLabel#lbl_breadcrumb_actual {
    color: #2C2A27;
    font-size: 13px;
    font-weight: 600;
}
QWidget#icono_destino {
    background-color: #EBE8E1;
    border-radius: 12px;
}
QLabel#lbl_nombre_paquete {
    font-size: 26px;
    font-weight: 700;
    color: #1A1917;
}
QLabel#lbl_meta {
    font-size: 13px;
    color: #6B6860;
}
QFrame#chip_frame {
    background-color: #F0EDE7;
    border-radius: 16px;
    border: 1px solid #E0DDD7;
}
QLabel#chip_label {
    font-size: 12px;
    color: #4A4845;
    padding: 4px 10px;
}
QWidget#stats_box {
    background-color: #F5F3EF;
    border-radius: 10px;
    border: 1px solid #E0DDD7;
}
QLabel#stat_valor {
    font-size: 20px;
    font-weight: 700;
    color: #1A1917;
}
QLabel#stat_label {
    font-size: 11px;
    color: #9A9690;
    text-transform: uppercase;
}
QLabel#lbl_desc_titulo {
    font-size: 10px;
    font-weight: 700;
    color: #9A9690;
    letter-spacing: 2px;
}
QLabel#lbl_descripcion {
    font-size: 13px;
    color: #4A4845;
    line-height: 1.6;
}
QLabel#lbl_reserva_titulo {
    font-size: 18px;
    font-weight: 700;
    color: #1A1917;
}
QLabel#lbl_campo {
    font-size: 12px;
    color: #6B6860;
    font-weight: 500;
}
QDateEdit, QSpinBox, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D4D0C8;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #1A1917;
    min-height: 20px;
}
QDateEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1.5px solid #8B7355;
    outline: none;
}
QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}
QWidget#total_box {
    background-color: #FFFFFF;
    border-radius: 10px;
    border: 1px solid #E0DDD7;
}
QLabel#lbl_total_label {
    font-size: 13px;
    color: #6B6860;
}
QLabel#lbl_total_valor {
    font-size: 28px;
    font-weight: 700;
    color: #1A1917;
}
QLabel#lbl_total_sub {
    font-size: 12px;
    color: #9A9690;
}
QPushButton#btn_confirmar {
    background-color: #2C2A27;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    padding: 14px 0;
    min-height: 24px;
}
QPushButton#btn_confirmar:hover { background-color: #3D3A35; }
QPushButton#btn_confirmar:pressed { background-color: #1A1917; }
QFrame#sep_vertical {
    background-color: #E0DDD7;
}
   </string>
